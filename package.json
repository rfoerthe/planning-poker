{
  "name": "planning-poker",
  "version": "3.1.4",
  "type": "module",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@types/react-lazy-load-image-component": "^1.6.5",
    "country-flag-icons": "^1.6.20",
    "firebase": "^12.18.0",
    "i18next": "^26.4.0",
    "react": "19.2.6",
    "react-cookie-consent": "^10.0.2",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.12",
    "react-lazy-load-image-component": "^1.6.3",
    "react-router": "^7.18.3",
    "typescript": "6.0.3",
    "ulid": "^3.0.2",
    "unique-names-generator": "^4.7.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "deploy": "node --env-file=.env scripts/deploy.mjs production",
    "preview-deploy": "node --env-file=.env scripts/deploy.mjs preview",
    "preview": "vite preview --port 5000",
    "clean": "rimraf dist",
    "games:list": "node --env-file=.env scripts/list-games.mjs",
    "games:lock": "node --env-file=.env scripts/lock-game.mjs",
    "games:unlock": "node --env-file=.env scripts/unlock-game.mjs",
    "games:delete": "node --env-file=.env scripts/delete-games.mjs",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-flow": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@types/react-router": "5.1.20",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "firebase-tools": "15.28.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
